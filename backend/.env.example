# Copy to .env and fill in. .env is git-ignored.
# Gemini (Google AI Studio) key — used first when set.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-flash-lite-latest
# Optional: Claude instead of Gemini (used when GEMINI_API_KEY is empty).
ANTHROPIC_API_KEY=
# Set to "off" to use only the built-in keyword rules.
TRAVELSPHERE_AI=
# DATABASE_URL=postgresql://travelsphere:travelsphere@localhost:5432/travelsphere
